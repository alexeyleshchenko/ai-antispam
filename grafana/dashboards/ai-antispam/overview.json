          "rawSql": "SELECT\n  CASE\n    WHEN score >= 80 THEN 'high (80+)'\n    WHEN score >= 50 THEN 'medium (50-79)'\n    ELSE 'low (<50)'\n  END AS \"score range\",\n  COUNT(*) AS \"count\"\nFROM spam_examples\nWHERE confirmed = true\nGROUP BY 1\nORDER BY 1",
