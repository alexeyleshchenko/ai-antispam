          "datasource": { "uid": "ai-antispam-pg", "type": "grafana-postgresql-datasource" },
          "format": "time_series",
          "rawSql": "SELECT\n  $__timeGroup(created_at, '1d') AS time,\n  COUNT(*) AS \"spam caught\"\nFROM spam_examples\nWHERE confirmed = true\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
